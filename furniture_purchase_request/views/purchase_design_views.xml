<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_furniture_design" model="ir.ui.view">
        <field name="name">purchase.order.form.furniture.design</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_furniture_purchase_design" separator=" "/>
            </xpath>
            <xpath expr="//sheet//field[@name='partner_id'][1]" position="attributes">
                <attribute name="class" add="o_furniture_purchase_partner" separator=" "/>
                <attribute name="widget">res_partner_many2one_avatar</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="class" add="o_furniture_purchase_lines" separator=" "/>
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="attributes">
                <attribute name="class" add="o_furniture_purchase_totals" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_furniture_vendor_design" model="ir.ui.view">
        <field name="name">account.move.form.furniture.vendor.design</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_furniture_account_document_design" separator=" "/>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <div class="o_furniture_vendor_bill_design_marker"
                     invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="attributes">
                <attribute name="class" add="o_furniture_vendor_bill_partner" separator=" "/>
                <attribute name="widget">res_partner_many2one_avatar</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="class" add="o_furniture_vendor_bill_lines" separator=" "/>
            </xpath>
            <xpath expr="(//group[hasclass('oe_subtotal_footer')])[1]" position="attributes">
                <attribute name="class" add="o_furniture_vendor_bill_totals" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>
