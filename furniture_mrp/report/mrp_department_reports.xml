<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- تقرير التقديم -->
    <record id="action_report_furniture_mrp_priming" model="ir.actions.report">
        <field name="name">أمر التقديم</field>
        <field name="model">furniture.mrp.priming</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">furniture_mrp.report_priming_template</field>
        <field name="report_file">furniture_mrp.report_priming_template</field>
        <field name="print_report_name">(object.name or 'أمر تقديم') + '.pdf'</field>
        <field name="binding_model_id" ref="model_furniture_mrp_priming"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

