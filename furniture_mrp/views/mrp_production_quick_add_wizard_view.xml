<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_production_first_line_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.production.first.line.wizard.form</field>
        <field name="model">furniture.mrp.production.first.line.wizard</field>
        <field name="arch" type="xml">
            <form string="إضافة أصناف للموديل" class="o_furniture_stage_transfer_wizard o_furniture_batch_product_wizard">
                <div class="o_furniture_transfer_hero">
                    <div>
                        <div class="o_furniture_transfer_eyebrow">إضافة جماعية بدل تكرار Add line</div>
                        <h2>اختار الموديل مرة واحدة ثم اختار كل المنتجات المطلوبة</h2>
                    </div>
                    <div class="o_furniture_transfer_icon">🧾</div>
                </div>

                <field name="production_id" invisible="1"/>
                <field name="create_new_production" invisible="1"/>
                <field name="model_locked" invisible="1"/>
                <field name="available_product_ids" invisible="1"/>
                <field name="product_id" invisible="1"/>
                <field name="product_qty" invisible="1"/>
                <field name="bom_id" invisible="1"/>
                <field name="width_cm" invisible="1"/>
                <field name="depth_cm" invisible="1"/>
                <field name="height_cm" invisible="1"/>

                <div class="o_furniture_line_quick_choices o_furniture_batch_product_choices">
                    <field name="furniture_order_model_id"
                           nolabel="1"
                           required="1"
                           readonly="model_locked"
                           class="o_furniture_quick_cards_field"
                           widget="furniture_quick_card_selector"
                           options="{'no_create': True, 'no_create_edit': True, 'quick_limit': 4, 'always_show_more': True, 'card_title': 'الموديل', 'card_subtitle': 'اختار موديل أمر الإنتاج مرة واحدة؛ كل السطور الجديدة ستأخذ نفس الموديل', 'card_icon': 'fa-cube', 'card_variant': 'model', 'order_by': 'sequence, name, id'}"/>
                    <field name="selected_product_ids"
                           nolabel="1"
                           invisible="not furniture_order_model_id"
                           class="o_furniture_quick_cards_field"
                           widget="furniture_multi_card_selector"
                           options="{'no_create': True, 'no_create_edit': True, 'quick_names': ['كنبة كبيرة', 'كنبة صغيرة', 'فوتيه', 'شازلونج'], 'quick_limit': 4, 'always_show_more': True, 'card_title': 'المنتجات النهائية', 'card_subtitle': 'اختار أكثر من منتج؛ كل اختيار سيظهر كسطر مستقل بالأسفل', 'card_icon': 'fa-cubes', 'card_variant': 'product', 'order_by': 'name, id'}"/>
                </div>

                <div class="o_furniture_line_customer_strip">
                    <div class="o_furniture_line_customer_field">
                        <span class="o_form_label">المشتري (الشركة)</span>
                        <field name="buyer_partner_id" nolabel="1"
                               context="{'default_is_company': True}"/>
                    </div>
                    <div class="o_furniture_line_customer_field">
                        <span class="o_form_label">المستفيد</span>
                        <field name="beneficiary_partner_id" nolabel="1"/>
                    </div>
                </div>

                <div class="o_furniture_batch_lines_heading" invisible="not selected_product_ids">
                    <div>
                        <strong>الكميات والمقاسات لكل منتج</strong>
                        <span>كل صف بالأسفل سيتحول إلى سطر مستقل داخل أمر التشغيل.</span>
                    </div>
                    <i class="fa fa-list-ul" title="سطور المنتجات"/>
                </div>
                <field name="line_ids" nolabel="1" invisible="not selected_product_ids"
                       class="o_furniture_batch_product_lines">
                    <list string="المنتجات المختارة" create="0" delete="0" editable="bottom">
                        <field name="sequence" column_invisible="1"/>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="bom_id" column_invisible="1" readonly="1" force_save="1"/>
                        <field name="product_qty" string="الكمية"/>
                        <field name="dimension_label" column_invisible="1"/>
                        <field name="dimensions_expanded"
                               string="المقاس"
                               widget="furniture_dimension_toggle"/>
                        <field name="width_cm" string="العرض (سم)"
                               invisible="not dimensions_expanded"/>
                        <field name="depth_cm" string="العمق (سم)"
                               invisible="not dimensions_expanded"/>
                        <field name="height_cm" string="الارتفاع (سم)"
                               invisible="not dimensions_expanded"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_lines" string="إنشاء أمر الإنتاج"
                            type="object" class="btn-primary o_furniture_transfer_confirm"
                            invisible="not create_new_production"/>
                    <button name="action_create_lines" string="إضافة المنتجات إلى أمر التشغيل"
                            type="object" class="btn-primary o_furniture_transfer_confirm"
                            invisible="create_new_production"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_furniture_mrp_new_production_product_wizard" model="ir.actions.act_window">
        <field name="name">إنشاء أمر إنتاج جديد</field>
        <field name="res_model">furniture.mrp.production.first.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_furniture_mrp_production_first_line_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_create_new_production': True, 'form_view_initial_mode': 'edit'}</field>
        <field name="groups_id" eval="[(6, 0, [ref('furniture_mrp.group_furniture_mrp_manager'), ref('furniture_mrp.group_furniture_mrp_supervisor')])]"/>
    </record>
</odoo>
