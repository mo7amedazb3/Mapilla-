<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_furniture_mrp_store_request" model="ir.sequence">
        <field name="name">طلب صرف خامات مراحل الأثاث</field>
        <field name="code">furniture.mrp.store.request</field>
        <field name="prefix">STR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_furniture_mrp_store_request_list" model="ir.ui.view">
        <field name="name">furniture.mrp.store.request.list</field>
        <field name="model">furniture.mrp.store.request</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-info="state == 'started'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="stage_code"/>
                <field name="requested_by_id"/>
                <field name="assigned_to_id"/>
                <field name="requested_at"/>
                <field name="state" widget="badge"/>
                <field name="receipt_state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_furniture_mrp_store_request_form" model="ir.ui.view">
        <field name="name">furniture.mrp.store.request.form</field>
        <field name="model">furniture.mrp.store.request</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_print_warehouse_receipt"
                            string="Print"
                            type="object"
                            icon="fa-print"
                            class="btn-secondary"
                            groups="furniture_mrp.group_furniture_mrp_storekeeper,furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor"/>
                    <button name="action_open_production_order" string="🏠 أمر الإنتاج" type="object"
                            class="btn-info"
                            groups="furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor"/>
                    <button name="action_open_mrp_dashboard" string="▦ لوحة التحكم" type="object"
                            class="btn-secondary"
                            groups="furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor"/>
                    <button name="action_open_receipt_wizard" string="📥 استلام من المخزن" type="object"
                            class="btn-primary"
                            invisible="state != 'approved' or receipt_confirmed or not material_line_ids"
                            groups="furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor"/>
                    <button name="action_approve" string="اعتماد الإذن" type="object"
                            class="btn-primary"
                            invisible="state != 'pending' or not can_warehouse_decide"
                            groups="furniture_mrp.group_furniture_mrp_storekeeper"/>
                    <button name="action_reject" string="رفض الطلب" type="object"
                            class="btn-secondary"
                            invisible="state != 'pending' or not can_warehouse_decide"
                            confirm="سيظل أمر المرحلة منتظرًا ولن تتحرك أي خامات. هل تريد الرفض؟"
                            groups="furniture_mrp.group_furniture_mrp_storekeeper"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,started,rejected"/>
                    <field name="can_warehouse_decide" invisible="1"/>
                    <field name="receipt_confirmed" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="بيانات الطلب">
                            <field name="production_id" readonly="1"/>
                            <field name="stage_code" readonly="1"/>
                            <field name="stage_order_name" readonly="1"/>
                            <field name="request_kind" readonly="1"/>
                            <field name="start_mode" readonly="1"/>
                        </group>
                        <group string="الاعتماد">
                            <field name="requested_by_id" readonly="1"/>
                            <field name="assigned_to_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="approved_by_id" readonly="1" invisible="not approved_by_id"/>
                            <field name="approved_at" readonly="1" invisible="not approved_at"/>
                            <field name="receipt_state" readonly="1" widget="badge"
                                   invisible="state == 'pending' or state == 'rejected'"/>
                            <field name="received_by_id" readonly="1" invisible="not received_by_id"/>
                            <field name="received_at" readonly="1" invisible="not received_at"/>
                            <field name="started_by_id" readonly="1" invisible="not started_by_id"/>
                            <field name="started_at" readonly="1" invisible="not started_at"/>
                        </group>
                    </group>
                    <group>
                        <group string="مسار الصرف">
                            <field name="source_location_id" readonly="1"/>
                            <field name="handover_location_id" readonly="1"/>
                            <field name="destination_location_id" readonly="1"/>
                        </group>
                        <group string="المنتجات المطلوب تشغيلها">
                            <field name="requested_product_summary" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group string="سبب الرفض" invisible="state not in ('pending', 'rejected')">
                        <field name="rejection_reason" nolabel="1" readonly="state != 'pending'"/>
                    </group>
                    <separator string="الخامات المطلوب صرفها"/>
                    <field name="material_line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0"
                              decoration-danger="shortage_qty &gt; 0">
                            <field name="product_id"/>
                            <field name="requested_qty"/>
                            <field name="product_uom_id"/>
                            <field name="available_qty"/>
                            <field name="shortage_qty"/>
                            <field name="issued_qty" optional="show"/>
                            <field name="received_qty" optional="show"/>
                            <field name="receipt_difference_qty" optional="show"
                                   decoration-danger="receipt_difference_qty &gt; 0"/>
                        </list>
                    </field>
                    <group string="ملاحظة استلام الإنتاج" invisible="not receipt_note">
                        <field name="receipt_note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_furniture_mrp_store_receipt_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.store.receipt.wizard.form</field>
        <field name="model">furniture.mrp.store.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="استلام خامات المرحلة من المخزن" create="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        سجل الكمية التي استلمتها فعليًا. الفرق يظل مسجلًا على عهدة أمين المخزن، ولن يكمله النظام تلقائيًا من Stock.
                    </div>
                    <group>
                        <group string="بيانات الإذن">
                            <field name="request_id" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                            <field name="stage_code" readonly="1"/>
                        </group>
                        <group string="مسار الاستلام">
                            <field name="handover_location_id" readonly="1"/>
                            <field name="destination_location_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="الخامات المستلمة فعليًا"/>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" editable="bottom"
                              decoration-warning="difference_qty &gt; 0">
                            <field name="product_id" readonly="1"/>
                            <field name="issued_qty" readonly="1"/>
                            <field name="received_qty"/>
                            <field name="difference_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                        </list>
                    </field>
                    <group string="ملاحظة أو سبب الفرق">
                        <field name="receipt_note" nolabel="1"
                               placeholder="اكتب سبب الفرق إذا استلمت كمية أقل..."/>
                    </group>
                    <field name="has_difference" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_confirm_receipt" type="object"
                            string="تأكيد الاستلام ونقل الفعلي للصالة"
                            class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_furniture_mrp_store_request" model="ir.actions.act_window">
        <field name="name">أذونات المخزن</field>
        <field name="res_model">furniture.mrp.store.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_furniture_mrp_store_request_search" model="ir.ui.view">
        <field name="name">furniture.mrp.store.request.search</field>
        <field name="model">furniture.mrp.store.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="production_id"/>
                <field name="stage_code"/>
                <filter name="pending" string="بانتظار الاعتماد" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="معتمد من المخزن" domain="[('state', '=', 'approved')]"/>
                <filter name="started" string="تم بدء المرحلة" domain="[('state', '=', 'started')]"/>
                <filter name="rejected" string="مرفوض" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_stage" string="المرحلة" context="{'group_by': 'stage_code'}"/>
                    <filter name="group_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
