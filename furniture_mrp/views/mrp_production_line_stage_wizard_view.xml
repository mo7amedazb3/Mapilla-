<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_production_line_stage_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.production.line.stage.wizard.form</field>
        <field name="model">furniture.mrp.production.line.stage.wizard</field>
        <field name="arch" type="xml">
            <form string="تعديل مراحل الصنف"
                  class="o_furniture_stage_transfer_wizard o_furniture_stage_selection_wizard">
                <div class="o_furniture_transfer_hero">
                    <div>
                        <div class="o_furniture_transfer_eyebrow">مسار الصنف داخل أمر التشغيل</div>
                        <h2>حدد المراحل المطلوبة لهذا الصنف</h2>
                    </div>
                    <div class="o_furniture_transfer_icon">✓</div>
                </div>
                <sheet class="o_furniture_wizard_sheet">
                    <group class="o_furniture_transfer_order o_furniture_wizard_meta">
                        <field name="production_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="stage_summary" readonly="1"/>
                    </group>
                    <group string="مراحل الصنف لهذا الأسبوع" col="4"
                           class="o_furniture_wizard_stage_grid">
                        <field name="use_priming" widget="furniture_stage_selector"
                               nolabel="1" colspan="4"
                               class="o_furniture_stage_cards_field"/>
                        <field name="use_painting" invisible="1"/>
                        <field name="use_carpentry" invisible="1"/>
                        <field name="use_bases" invisible="1"/>
                        <field name="use_finishing" invisible="1"/>
                        <field name="use_tailoring" invisible="1"/>
                        <field name="use_upholstery" invisible="1"/>
                        <field name="use_packaging" invisible="1"/>
                    </group>
                    <div class="o_furniture_transfer_contents_hint o_furniture_wizard_note">
                        الاختيارات هنا تخص الصنف ده فقط، وبعد التطبيق الخامات وملخص المراحل هيتحدثوا تلقائيًا.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" string="تطبيق" type="object"
                            class="btn-primary o_furniture_transfer_confirm"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
