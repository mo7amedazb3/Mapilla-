<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="product_stock_compact_numbers" model="ir.ui.view">
    <field name="name">product.product.product_stock_compact_numbers</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="stock.view_stock_product_tree"/>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lst_price']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='standard_price']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='qty_available']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='virtual_available']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
    </field>
  </record>
  <record id="product_template_stock_compact_numbers" model="ir.ui.view">
    <field name="name">product.template.product_template_stock_compact_numbers</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='list_price']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='standard_price']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='qty_available']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='virtual_available']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
    </field>
  </record>
  <record id="stock_quant_compact_numbers" model="ir.ui.view">
    <field name="name">stock.quant.stock_quant_compact_numbers</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='reserved_quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='available_quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
    </field>
  </record>
  <record id="stock_quant_simple_compact_numbers" model="ir.ui.view">
    <field name="name">stock.quant.stock_quant_simple_compact_numbers</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='available_quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
    </field>
  </record>
  <record id="stock_quant_inventory_compact_numbers" model="ir.ui.view">
    <field name="name">stock.quant.stock_quant_inventory_compact_numbers</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
    <field name="priority">90</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='available_quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
      <xpath expr="//field[@name='inventory_diff_quantity']" position="attributes">
        <attribute name="widget">furniture_compact_quantity</attribute>
      </xpath>
    </field>
  </record>
</odoo>
