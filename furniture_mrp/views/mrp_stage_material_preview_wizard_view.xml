<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_stage_material_preview_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.stage.material.preview.wizard.form</field>
        <field name="model">furniture.mrp.stage.material.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="الخامات المطلوبة للصنف"
                  class="o_furniture_stage_transfer_wizard o_furniture_material_preview_wizard">
                <div class="o_furniture_transfer_hero">
                    <div>
                        <div class="o_furniture_transfer_eyebrow">تفاصيل طلب إذن المخزن</div>
                        <h2>الخامات المطلوبة للصنف <field name="product_label" nolabel="1" readonly="1" class="oe_inline"/></h2>
                    </div>
                    <div class="o_furniture_transfer_icon">📦</div>
                </div>
                <group class="o_furniture_transfer_order">
                    <group>
                        <field name="production_id"/>
                        <field name="product_id" invisible="1"/>
                        <field name="product_label" invisible="1"/>
                        <field name="source_wizard_line_model" invisible="1"/>
                        <field name="source_wizard_line_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="stage_code"/>
                        <field name="output_qty"/>
                        <field name="output_uom_id"/>
                    </group>
                </group>
                <div class="o_furniture_transfer_card o_furniture_transfer_contents">
                    <div class="o_furniture_transfer_card_title">الخامات التي سترسل لأمين المخزن</div>
                    <div class="o_furniture_transfer_contents_hint">
                        الكميات محسوبة حسب المنتج والمرحلة وكمية التشغيل التي اخترتها في الويزارد.
                    </div>
                    <field name="line_ids" nolabel="1"
                           class="o_furniture_standard_transfer_lines o_furniture_wizard_list">
                        <list create="false" delete="false" editable="bottom">
                            <field name="product_id" string="الخامة" readonly="1"/>
                            <field name="requested_qty" string="الكمية المطلوبة"/>
                            <field name="product_uom_id" string="الوحدة" readonly="1"/>
                            <field name="available_qty" string="المتاح حاليًا" readonly="1"/>
                            <field name="shortage_qty" string="العجز"
                                   decoration-danger="shortage_qty &gt; 0"
                                   decoration-success="shortage_qty == 0"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_apply_quantities" string="اعتماد الكميات المعدلة"
                            type="object" class="btn-primary o_furniture_transfer_confirm"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
