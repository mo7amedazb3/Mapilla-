<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_stage_quality_send_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.stage.quality.send.wizard.form</field>
        <field name="model">furniture.mrp.stage.quality.send.wizard</field>
        <field name="arch" type="xml">
            <form string="اختيار أصناف الجودة" class="o_furniture_stage_transfer_wizard">
                <div class="o_furniture_transfer_hero">
                    <div>
                        <div class="o_furniture_transfer_eyebrow">إرسال جزئي للجودة</div>
                        <h2>اختار الأصناف اللي خلصت في مرحلة <field name="stage_label" nolabel="1" readonly="1" class="oe_inline"/>.</h2>
                    </div>
                    <div class="o_furniture_transfer_icon">🔍</div>
                </div>
                <group class="o_furniture_transfer_order">
                    <field name="production_id"/>
                    <field name="stage_code" invisible="1"/>
                    <field name="stage_order_model" invisible="1"/>
                    <field name="stage_order_res_id" invisible="1"/>
                    <field name="stage_label" invisible="1"/>
                </group>
                <div class="o_furniture_transfer_card o_furniture_transfer_contents">
                    <div class="o_furniture_transfer_card_title">الأصناف الجاهزة للفحص</div>
                    <div class="o_furniture_transfer_contents_hint"
                         invisible="stage_code in ('tailoring', 'upholstery')">
                        اختار الصنف وحدد كمية الإرسال؛ الكمية المرسلة فقط هتدخل فحص الجودة والباقي هيفضل في المرحلة لحد ما تبعته بعدين.
                    </div>
                    <div class="o_furniture_transfer_contents_hint o_furniture_model_group_hint"
                         invisible="stage_code not in ('tailoring', 'upholstery')">
                        الأطقم ظاهرة بنفس التقسيمة المحفوظة في أمر التشغيل. كل قطعة ما زالت مستقلة في التتبع؛ اختار فقط القطع التي انتهت فعلًا داخل كل طقم.
                    </div>
                    <field name="line_ids" nolabel="1"
                           invisible="stage_code in ('tailoring', 'upholstery')"
                           class="o_furniture_standard_transfer_lines o_furniture_wizard_list">
                        <list create="false" delete="false" editable="bottom">
                            <field name="selected"/>
                            <field name="production_line_id" invisible="1"/>
                            <field name="technical_production_line_ids" invisible="1" column_invisible="1"/>
                            <field name="product_id" invisible="1"/>
                            <field name="product_display_label" string="الصنف" readonly="1"/>
                            <field name="dimension_label" string="المقاس" widget="badge"
                                   class="o_furniture_dimension_badge" readonly="1"
                                   decoration-info="dimension_label"/>
                            <field name="product_qty" string="الكمية الجاهزة" readonly="1"/>
                            <field name="qty_to_send" string="كمية الإرسال" force_save="1"/>
                            <field name="product_uom_id" string="الوحدة" readonly="1"/>
                            <field name="stage_summary" string="مراحل الصنف" readonly="1" optional="show"/>
                        </list>
                    </field>
                    <field name="line_ids" nolabel="1"
                           invisible="stage_code not in ('tailoring', 'upholstery')"
                           class="o_furniture_model_grouped_transfer_lines o_furniture_quality_grouped_lines o_furniture_wizard_list">
                        <list editable="bottom" create="false" delete="false"
                              decoration-bf="is_model_header"
                              decoration-primary="is_model_header and kit_instance_number and kit_instance_number % 5 == 1"
                              decoration-success="is_model_header and kit_instance_number and kit_instance_number % 5 == 2"
                              decoration-warning="is_model_header and kit_instance_number and kit_instance_number % 5 == 3"
                              decoration-danger="is_model_header and kit_instance_number and kit_instance_number % 5 == 4"
                              decoration-info="is_model_header and (not kit_instance_number or kit_instance_number % 5 == 0)">
                            <field name="sequence" column_invisible="1"/>
                            <field name="is_model_header" column_invisible="1"/>
                            <field name="model_group_label" column_invisible="1"/>
                            <field name="kit_group_token" column_invisible="1" force_save="1"/>
                            <field name="kit_bom_id" column_invisible="1" force_save="1"/>
                            <field name="kit_instance_number" column_invisible="1" force_save="1"/>
                            <field name="production_line_id" column_invisible="1" force_save="1"/>
                            <field name="product_id" column_invisible="1"/>
                            <field name="selected" string="إرسال" invisible="is_model_header" force_save="1"/>
                            <field name="product_display_label" string="الصنف / الطقم" readonly="1"/>
                            <field name="furniture_model_id" string="الموديل" widget="badge"
                                   class="o_furniture_transfer_model_badge" readonly="1"/>
                            <field name="buyer_partner_id" string="المشتري (الشركة)" readonly="1" optional="show"/>
                            <field name="beneficiary_partner_id" string="المستفيد" readonly="1" optional="show"/>
                            <field name="dimension_label" string="المقاس" widget="badge"
                                   class="o_furniture_dimension_badge" readonly="1"
                                   invisible="is_model_header" decoration-info="dimension_label"/>
                            <field name="batch_image_1920" string="صورة القطعة" widget="image"
                                   options="{'size': [96, 72], 'img_class': 'object-fit-contain'}"
                                   readonly="1" invisible="is_model_header"/>
                            <field name="stage_material_summary" string="خامات المرحلة" widget="html"
                                   readonly="1" invisible="is_model_header" optional="hide"/>
                            <field name="product_qty" string="الكمية" readonly="1" invisible="is_model_header"/>
                            <field name="product_uom_id" string="الوحدة" readonly="1" invisible="is_model_header"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_send_selected_to_quality" string="إرسال المختار للجودة" type="object" class="btn-primary o_furniture_transfer_confirm"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
