<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action to open products for a specific location -->
    <record id="action_furniture_location_quants" model="ir.actions.act_window">
        <field name="name">المنتجات بالمخزن</field>
        <!-- A furniture Kit is a sales-only phantom BoM. Its computed stock is
             derived from its components, so show the variants that own the
             physical stock quants instead of the virtual Kit parent. -->
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qty_available', '>', 0), ('is_kits', '=', False)]</field>
        <field name="context">{'location': active_id, 'active_test': False, 'create': False}</field>
    </record>

    <!-- Beautiful Kanban View for Locations -->
    <record id="view_furniture_mrp_location_kanban" model="ir.ui.view">
        <field name="name">furniture.mrp.location.kanban</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_furniture_locations_board" create="0">
                <field name="name"/>
                <field name="complete_name"/>
                <field name="usage"/>
                <field name="company_id"/>
                <field name="id"/>
                <templates>
                    <t t-name="kanban-box">
                        <a type="action" name="%(action_furniture_location_quants)d" class="o_furniture_location_kanban">
                            <div class="loc_title">
                                <i class="fa fa-building-o" t-if="record.usage.raw_value == 'internal'"></i>
                                <i class="fa fa-truck" t-if="record.usage.raw_value == 'transit'"></i>
                                <i class="fa fa-archive" t-if="record.usage.raw_value == 'inventory'"></i>
                                <span><t t-esc="record.name.value"/></span>
                            </div>
                            <div class="loc_info">
                                <div><i class="fa fa-sitemap"></i> <span><t t-esc="record.complete_name.value"/></span></div>
                                <div><i class="fa fa-tag"></i> <span class="badge badge-pill badge-light border"><t t-esc="record.usage.value"/></span></div>
                            </div>
                            <div class="loc_btn">
                                <i class="fa fa-hand-pointer-o"></i> اضغط لعرض المنتجات
                            </div>
                        </a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Main Action for Locations -->
    <record id="action_furniture_mrp_locations" model="ir.actions.act_window">
        <field name="name">المخازن</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain" eval="[('id', 'in', [ref('furniture_mrp.location_stage_priming_wip'), ref('furniture_mrp.location_stage_priming'), ref('furniture_mrp.location_stage_painting_wip'), ref('furniture_mrp.location_stage_painting'), ref('furniture_mrp.location_stage_carpentry_wip'), ref('furniture_mrp.location_stage_carpentry'), ref('furniture_mrp.location_stage_bases_wip'), ref('furniture_mrp.location_stage_bases'), ref('furniture_mrp.location_stage_finishing_wip'), ref('furniture_mrp.location_stage_finishing'), ref('furniture_mrp.location_stage_tailoring_wip'), ref('furniture_mrp.location_stage_tailoring'), ref('furniture_mrp.location_stage_upholstery_wip'), ref('furniture_mrp.location_stage_upholstery'), ref('furniture_mrp.location_stage_packaging'), ref('furniture_mrp.location_finished_goods'), ref('stock.stock_location_stock')])]"/>
        <field name="view_id" ref="view_furniture_mrp_location_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد مخازن</p>
            <p>من هنا تقدر تراجع كل مخازن المصنع وتتنقل بينها.</p>
        </field>
    </record>
</odoo>
