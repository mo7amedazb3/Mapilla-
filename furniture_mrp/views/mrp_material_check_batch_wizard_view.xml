<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_material_check_batch_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.material.check.batch.wizard.form</field>
        <field name="model">furniture.mrp.material.check.batch.wizard</field>
        <field name="arch" type="xml">
            <form string="فحص المواد المجمع" create="0" delete="0"
                  class="o_furniture_batch_release_wizard o_furniture_material_check_batch_form">
                <sheet class="o_furniture_batch_release_sheet o_furniture_material_check_batch_sheet">
                    <field name="company_id" invisible="1"/>

                    <div class="o_furniture_transfer_hero o_furniture_batch_release_hero">
                        <span class="o_furniture_transfer_hero_icon" aria-hidden="true">
                            <i class="fa fa-search"/>
                        </span>
                        <div>
                            <h2>فحص وحجز خامات عدة أوامر</h2>
                            <p>
                                اختار أوامر الإنتاج، وسيتم حجز المتاح لها وتحديث
                                طلبات شراء العجز بنفس منطق زر فحص المواد داخل الأمر.
                            </p>
                        </div>
                    </div>

                    <div class="o_furniture_material_check_batch_toolbar">
                        <div class="o_furniture_material_check_batch_counts">
                            <span>
                                <strong><field name="eligible_count" readonly="1"/></strong>
                                أمر مؤكد متاح
                            </span>
                            <span class="is-selected">
                                <strong><field name="selected_count" readonly="1"/></strong>
                                أمر مختار
                            </span>
                        </div>
                        <field name="select_all"
                               widget="furniture_batch_material_check_select_all"
                               nolabel="1"/>
                    </div>

                    <div class="alert alert-info" role="alert" invisible="line_ids">
                        لا توجد أوامر إنتاج مؤكدة متاحة للفحص حاليًا.
                    </div>

                    <field name="line_ids" nolabel="1" mode="kanban"
                           class="o_furniture_batch_release_lines">
                        <form string="اختيار أمر لفحص المواد">
                            <field name="production_id" force_save="1"/>
                            <field name="selected"/>
                            <field name="production_state"/>
                            <field name="model_id"/>
                            <field name="date_planned_start"/>
                            <field name="date_planned_finish"/>
                            <field name="product_summary" force_save="1"/>
                            <field name="buyer_summary" force_save="1"/>
                            <field name="beneficiary_summary" force_save="1"/>
                            <field name="material_reservation_state"/>
                            <field name="materials_checked_at"/>
                        </form>
                        <kanban create="0" edit="0" delete="0" can_open="0"
                                records_draggable="0"
                                class="o_furniture_batch_release_orders o_furniture_material_check_orders">
                            <field name="production_id" force_save="1"/>
                            <field name="selected"/>
                            <field name="production_state"/>
                            <field name="model_id"/>
                            <field name="date_planned_start"/>
                            <field name="date_planned_finish"/>
                            <field name="product_summary" force_save="1"/>
                            <field name="buyer_summary" force_save="1"/>
                            <field name="beneficiary_summary" force_save="1"/>
                            <field name="material_reservation_state"/>
                            <field name="materials_checked_at"/>
                            <templates>
                                <t t-name="card">
                                    <article class="o_furniture_batch_release_order_card o_furniture_material_check_order_card"
                                             t-att-class="{'is-order-selected': record.selected.raw_value}">
                                        <div class="o_furniture_batch_release_order_header">
                                            <div>
                                                <span class="o_furniture_batch_release_order_eyebrow">أمر إنتاج</span>
                                                <strong><field name="production_id"/></strong>
                                            </div>
                                            <field name="material_reservation_state"
                                                   widget="badge"
                                                   decoration-success="material_reservation_state == 'full'"
                                                   decoration-warning="material_reservation_state == 'partial'"
                                                   decoration-muted="material_reservation_state == 'none'"/>
                                        </div>

                                        <div class="o_furniture_batch_release_products">
                                            <i class="fa fa-cubes" title="الأصناف" aria-hidden="true"/>
                                            <field name="product_summary"/>
                                        </div>

                                        <div class="o_furniture_material_check_order_meta">
                                            <span>
                                                <i class="fa fa-object-group" title="الموديل" aria-hidden="true"/>
                                                <field name="model_id"/>
                                            </span>
                                            <span>
                                                <i class="fa fa-user" title="المشتري" aria-hidden="true"/>
                                                <field name="buyer_summary"/>
                                            </span>
                                            <span>
                                                <i class="fa fa-user-circle" title="المستفيد" aria-hidden="true"/>
                                                <field name="beneficiary_summary"/>
                                            </span>
                                        </div>

                                        <div class="o_furniture_material_check_order_dates">
                                            <span>
                                                <small>البدء المخطط</small>
                                                <field name="date_planned_start"/>
                                            </span>
                                            <span>
                                                <small>الانتهاء المخطط</small>
                                                <field name="date_planned_finish"/>
                                            </span>
                                            <span t-if="record.materials_checked_at.raw_value">
                                                <small>آخر فحص</small>
                                                <field name="materials_checked_at"/>
                                            </span>
                                        </div>

                                        <field name="selected"
                                               widget="furniture_batch_material_check_selector"
                                               nolabel="1"/>
                                    </article>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>

                <footer>
                    <button name="action_check_selected_materials"
                            string="فحص وحجز الأوامر المختارة"
                            type="object"
                            class="btn-warning o_furniture_material_check_batch_confirm"
                            groups="furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_furniture_mrp_material_check_batch_wizard" model="ir.actions.act_window">
        <field name="name">فحص المواد المجمع</field>
        <field name="res_model">furniture.mrp.material.check.batch.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_furniture_mrp_material_check_batch_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'form_view_initial_mode': 'edit', 'auto_load_eligible_productions': True}</field>
        <field name="groups_id" eval="[(6, 0, [ref('furniture_mrp.group_furniture_mrp_manager'), ref('furniture_mrp.group_furniture_mrp_supervisor')])]"/>
    </record>
</odoo>
