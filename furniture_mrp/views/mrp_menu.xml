              groups="furniture_mrp.group_furniture_mrp_manager,furniture_mrp.group_furniture_mrp_supervisor,base.group_user"/>
    <!-- Without a fixed root action Odoo opens the first child the caller can
         access: managers land on the factory dashboard, workers on their MPS
         queue.  This avoids sending a worker to the manager-only dashboard. -->
    <record id="menu_furniture_mrp_root" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem id="menu_furniture_product_configuration"
              name="تصنيف المنتجات"
