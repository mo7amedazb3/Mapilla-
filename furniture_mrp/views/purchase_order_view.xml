<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_furniture_uom" model="ir.ui.view">
        <field name="name">purchase.order.form.furniture.uom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='order_line']//list//field[@name='product_uom'])[2]" position="replace"/>
            <xpath expr="(//field[@name='order_line']//list//field[@name='product_uom'])[1]" position="replace"/>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_qty']" position="after">
                <field name="product_uom"
                       string="وحدة القياس"
                       domain="[('furniture_mrp_bom_uom', '=', True)]"
                       readonly="state in ('purchase', 'done', 'cancel') or is_downpayment"
                       required="not display_type and not is_downpayment"
                       options="{'no_open': True, 'no_create_edit': True}"
                       force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
