<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_furniture_mrp_future_order_company" model="ir.rule">
            <field name="name">طلبات التسليم المستقبلية: شركات المستخدم</field>
            <field name="model_id" ref="model_furniture_mrp_future_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_furniture_mrp_manager'))]"/>
        </record>
        <record id="rule_furniture_mrp_future_order_line_company" model="ir.rule">
            <field name="name">سطور طلبات التسليم المستقبلية: شركات المستخدم</field>
            <field name="model_id" ref="model_furniture_mrp_future_order_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_furniture_mrp_manager'))]"/>
        </record>
    </data>
</odoo>
