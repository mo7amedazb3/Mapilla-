            <field name="domain_force">[('production_order_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!--
            أذونات الصرف المجمعة تحتوي بيانات كل المراحل. امنع مستخدم Odoo
            الداخلي من تعدادها مباشرة عبر ORM، ثم افتح الرأس للمدير/المخزن
            فقط، وافتح سطر المرحلة وخاماته لمشرف نفس المرحلة والشركة فقط.

            قواعد المجموعات في Odoo تُجمع بـ OR؛ لذلك قاعدة المنع العامة
            تعمل كـ default-deny، وقواعد الأدوار التالية هي الاستثناءات
            الصريحة. المستخدم المشرف على أكثر من مرحلة يرى اتحاد مراحله.
        -->
        <record id="rule_advance_material_release_internal_deny" model="ir.rule">
            <field name="name">إذن الصرف المجمع: منع داخلي افتراضي</field>
            <field name="model_id" ref="model_furniture_mrp_advance_material_release"/>
            <field name="domain_force">[('id', '=', 0)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_advance_material_release_manager_company" model="ir.rule">
            <field name="name">إذن الصرف المجمع: شركات مدير المصنع</field>
