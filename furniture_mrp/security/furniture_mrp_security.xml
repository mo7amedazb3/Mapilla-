            <field name="name">مرحلة التقديم: شركات المستخدم</field>
            <field name="model_id" ref="model_furniture_mrp_priming"/>
            <field name="domain_force">[('production_order_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

