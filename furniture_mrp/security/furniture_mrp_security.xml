<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ══════════════════════════════════════════════════════════════════
             مجموعات الأمان لمصنع الأثاث
        ══════════════════════════════════════════════════════════════════ -->
        <record id="module_category_furniture_mrp" model="ir.module.category">
            <field name="name">إدارة إنتاج الأثاث</field>
            <field name="description">نظام إدارة الإنتاج لمصنع الأثاث الخشبي</field>
            <field name="sequence">100</field>
        </record>

        <!-- مجموعة: موظف مطابقة التجهيز والكسوة وإتمام المنتج -->
        <record id="group_furniture_mrp_completion_operator" model="res.groups">
            <field name="name">موظف إتمام المنتج</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مطابقة رصيد التجهيز مع رصيد الكسوة والتفصيل وحجزهما وإتمام المنتج النهائي.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- مجموعة: مدير المصنع -->
        <record id="group_furniture_mrp_manager" model="res.groups">
            <field name="name">مدير المصنع</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">صلاحيات كاملة على جميع أقسام المصنع</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('group_furniture_mrp_completion_operator')),
                (4, ref('hr.group_hr_user')),
                (4, ref('hr_contract.group_hr_contract_manager')),
                (4, ref('hr_attendance.group_hr_attendance_manager')),
                (4, ref('stock.group_stock_user'))
            ]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- مجموعة: مشرف الإنتاج -->
        <record id="group_furniture_mrp_supervisor" model="res.groups">
            <field name="name">مشرف الإنتاج</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">صلاحيات الإشراف على أوامر الإنتاج وتتبعها</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- مجموعات مشرفي المراحل: نقاط ربط مستقرة للصلاحيات التفصيلية -->
        <record id="group_furniture_mrp_supervisor_priming" model="res.groups">
            <field name="name">مشرف مرحلة التقديم</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف التقديم؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_painting" model="res.groups">
            <field name="name">مشرف مرحلة تصنيع الدهانات</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف تصنيع الدهانات؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_carpentry" model="res.groups">
            <field name="name">مشرف مرحلة التجميع</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف التجميع؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_bases" model="res.groups">
