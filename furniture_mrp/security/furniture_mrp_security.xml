            <field name="comment">مجموعة مشرف القواعد؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_finishing" model="res.groups">
            <field name="name">مشرف مرحلة التجهيز</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف التجهيز؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_tailoring" model="res.groups">
            <field name="name">مشرف مرحلة التفصيل</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف التفصيل؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_sewing" model="res.groups">
            <field name="name">مشرف مرحلة الخياطة</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف الخياطة؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_upholstery" model="res.groups">
            <field name="name">مشرف مرحلة الكسوة</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف الكسوة؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <record id="group_furniture_mrp_supervisor_packaging" model="res.groups">
            <field name="name">مشرف مرحلة التغليف</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">مجموعة مشرف التغليف؛ تُربط بها صلاحيات المرحلة بالكود.</field>
            <field name="implied_ids" eval="[(4, ref('group_furniture_mrp_supervisor'))]"/>
        </record>

        <!-- مجموعة: أمين المخزن -->
        <record id="group_furniture_mrp_storekeeper" model="res.groups">
            <field name="name">أمين المخزن</field>
            <field name="category_id" ref="module_category_furniture_mrp"/>
            <field name="comment">اعتماد طلبات صرف خامات مراحل الإنتاج قبل خروجها من المخزن</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- سجل الموديل الجديد: جدول الأصناف داخل MPS -->
        <record id="model_furniture_mrp_mps_line" model="ir.model">
            <field name="name">سطر جدول الإنتاج الرئيسي (MPS)</field>
            <field name="model">furniture.mrp.mps.line</field>
            <field name="state">base</field>
        </record>

        <!-- سجل الموديل الجديد: سطور الأصناف داخل أمر التشغيل الأسبوعي -->
        <record id="model_furniture_mrp_production_line" model="ir.model">
            <field name="name">سطر صنف داخل أمر التشغيل الأسبوعي</field>
            <field name="model">furniture.mrp.production.line</field>
            <field name="state">base</field>
        </record>

        <!-- كل مستخدم يرى سجلات المراحل التابعة لشركاته النشطة فقط. -->
