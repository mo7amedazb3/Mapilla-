<odoo>
    <record id="view_employee_lunch_setting" model="ir.ui.view">
        <field name="name">hr.employee.mrp.lunch.setting</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="furniture_mrp.view_hr_employee_form_furniture_mrp"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='furniture_mrp_role']" position="after">
                <field name="factory_lunch_enabled" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
