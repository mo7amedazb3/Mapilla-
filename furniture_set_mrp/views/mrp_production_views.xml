<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_furniture_set" model="ir.ui.view">
        <field name="name">mrp.production.form.furniture.set</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_open_extra_material_wizard"
                        type="object"
                        string="Extra Material"
                        class="btn-secondary"
                        invisible="not can_request_extra_material"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_extra_materials"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-plus-circle"
                        invisible="extra_material_count == 0">
                    <field name="extra_material_count" widget="statinfo" string="Extra Materials"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="can_request_extra_material" invisible="1"/>
                <field name="extra_material_count" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']//field[@name='product_uom_qty']" position="after">
                <field name="is_extra_material" optional="show"/>
                <field name="extra_material_reason" optional="hide"/>
                <field name="extra_material_user_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
