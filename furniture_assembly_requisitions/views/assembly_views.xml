<odoo>
    <record id="priming_form_hall_stock" model="ir.ui.view">
        <field name="name">priming.form.shared.hall.stock</field>
        <field name="model">furniture.mrp.priming</field>
        <field name="inherit_id" ref="furniture_mrp.view_furniture_mrp_priming_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info" role="status">الخامات التي تم توريدها يدويًا من «طلب الاذونات» تُستهلك من رصيد صالة التقديم، وباقي خامات التقديم تظل ضمن طلب خامات المرحلة العادي.</div>
            </xpath>
        </field>
    </record>

