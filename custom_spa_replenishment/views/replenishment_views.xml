<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_raw_material_orderpoint_list" model="ir.ui.view">
        <field name="name">spa.raw.material.orderpoint.list</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <list string="Central Warehouse Purchase Levels" editable="bottom"
                  multi_edit="1" create="0" delete="0"
                  decoration-danger="spa_purchase_state == 'no_supplier'"
                  decoration-warning="spa_purchase_state in ('to_order', 'partial_order')"
                  decoration-info="spa_purchase_state == 'ordered'"
                  decoration-success="spa_purchase_state == 'ok'">
                <header>
                    <button name="spa_sync_purchase_materials" type="object"
                            string="Refresh Materials" class="btn-secondary"
                            display="always"/>
                    <button name="action_spa_prepare_rfq" type="object"
                            string="Prepare Purchase Request" class="btn-primary"/>
                </header>
                <field name="spa_raw_material" column_invisible="True"/>
                <field name="spa_replenishment_scope" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
                <field name="trigger" column_invisible="True"/>
                <field name="route_id" column_invisible="True"/>
                <field name="product_id" readonly="1"/>
                <field name="spa_supplier_id" string="Default Supplier" readonly="1"/>
                <field name="qty_on_hand" string="On Hand" readonly="1"/>
                <field name="qty_forecast" string="Forecast" readonly="1"/>
                <field name="product_min_qty" string="Minimum"/>
                <field name="product_max_qty" string="Maximum"/>
                <field name="spa_required_qty" string="Required To Maximum" readonly="1"/>
                <field name="spa_ordered_qty" string="Already Ordered" readonly="1"/>
                <field name="spa_qty_to_order" string="Remaining To Order" readonly="1"/>
                <field name="product_uom_name" string="Unit" readonly="1"/>
                <field name="spa_purchase_state" widget="badge" readonly="1"
                       decoration-danger="spa_purchase_state == 'no_supplier'"
                       decoration-warning="spa_purchase_state in ('to_order', 'partial_order')"
                       decoration-info="spa_purchase_state == 'ordered'"
                       decoration-success="spa_purchase_state == 'ok'"/>
                <button name="action_spa_prepare_rfq" type="object"
                        string="Request Purchase" icon="fa-paper-plane"
                        class="btn-primary"
                        invisible="spa_purchase_state not in ('to_order', 'partial_order', 'no_supplier')"/>
            </list>
        </field>
    </record>

    <record id="view_spa_raw_material_orderpoint_search" model="ir.ui.view">
        <field name="name">spa.raw.material.orderpoint.search</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <search string="Raw Materials">
                <field name="product_id"/>
                <field name="spa_supplier_id"/>
                <filter name="to_order" string="To Order"
                        domain="[('spa_purchase_state', 'in', ['to_order', 'partial_order', 'no_supplier'])]"/>
                <filter name="ordered" string="Ordered"
                        domain="[('spa_purchase_state', '=', 'ordered')]"/>
                <group expand="0" string="Group By">
                    <filter name="category" string="Category"
                            context="{'group_by': 'product_category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spa_raw_material_replenishment_list" model="ir.actions.act_window">
        <field name="name">Central Purchase Replenishment</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spa_raw_material_orderpoint_list"/>
        <field name="search_view_id" ref="view_spa_raw_material_orderpoint_search"/>
        <field name="domain">[('spa_replenishment_scope', '=', 'central_purchase')]</field>
        <field name="context">{'search_default_to_order': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure minimum and maximum quantities for purchasable raw materials.</p>
            <p>When forecast stock reaches the minimum, the difference up to the maximum appears as To Order.</p>
        </field>
    </record>

    <record id="view_spa_central_purchase_request_list" model="ir.ui.view">
        <field name="name">spa.central.purchase.request.list</field>
        <field name="model">furniture.purchase.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'requested'"
                  decoration-success="state == 'rfq_created'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="requested_by_id"/>
                <field name="rfq_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_spa_central_purchase_request_form" model="ir.ui.view">
        <field name="name">spa.central.purchase.request.form</field>
        <field name="model">furniture.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Central Purchase Request">
                <header>
                    <button name="action_submit" type="object" string="Submit Request"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="stock.group_stock_manager,custom_spa_replenishment.group_spa_central_inventory"/>
                    <button name="action_create_rfqs" type="object" string="Create RFQs"
                            class="btn-primary"
                            invisible="state != 'requested' or not can_create_rfqs"
                            groups="purchase.group_purchase_user"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'requested')"
                            groups="stock.group_stock_manager,purchase.group_purchase_user,custom_spa_replenishment.group_spa_central_inventory"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,rfq_created"/>
                </header>
                <sheet>
                    <field name="can_create_rfqs" invisible="1"/>
                    <field name="spa_central_replenishment" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfqs" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="rfq_count == 0"
                                groups="purchase.group_purchase_user">
                            <field name="rfq_count" widget="statinfo" string="RFQs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id" readonly="1"
                                   options="{'no_open': True, 'no_create': True}"/>
                            <field name="requested_by_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids"
                           readonly="state in ('rfq_created', 'cancelled') or (state == 'requested' and not can_create_rfqs)">
                        <list editable="bottom" delete="1">
                            <field name="product_id" readonly="parent.state != 'draft' or purchase_order_id"
                                   domain="[('purchase_ok', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="quantity" readonly="parent.state != 'draft' or purchase_order_id"/>
                            <field name="product_uom_category_id" column_invisible="True"/>
                            <field name="product_uom_id"
                                   readonly="parent.state != 'draft' or purchase_order_id"
                                   domain="[('category_id', '=', product_uom_category_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="suggested_supplier_id" readonly="1"
                                   column_invisible="not parent.can_create_rfqs"/>
                            <field name="supplier_id"
                                   readonly="parent.state != 'requested' or purchase_order_id"
                                   column_invisible="not parent.can_create_rfqs"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="purchase_order_id" readonly="1"/>
                        </list>
                    </field>
                    <field name="note" readonly="state in ('rfq_created', 'cancelled')"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_spa_central_purchase_request" model="ir.actions.act_window">
        <field name="name">Central Purchase Requests</field>
        <field name="res_model">furniture.purchase.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('spa_central_replenishment', '=', True)]</field>
        <field name="context">{'default_spa_central_replenishment': True}</field>
    </record>

    <record id="action_spa_central_purchase_request_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spa_central_purchase_request_list"/>
        <field name="act_window_id" ref="action_spa_central_purchase_request"/>
    </record>

    <record id="action_spa_central_purchase_request_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_spa_central_purchase_request_form"/>
        <field name="act_window_id" ref="action_spa_central_purchase_request"/>
    </record>

    <record id="action_spa_raw_material_replenishment" model="ir.actions.client">
        <field name="name">Central Purchase Replenishment</field>
        <field name="tag">custom_spa_replenishment.central_purchase_dashboard</field>
        <field name="target">current</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Configure minimum and maximum quantities for purchasable raw materials. When forecast stock reaches the minimum, the difference up to the maximum appears as To Order.</p>
        </field>
    </record>

    <menuitem id="menu_spa_raw_material_replenishment"
              name="Central Purchase Replenishment"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_spa_raw_material_replenishment"
              sequence="27"
              groups="stock.group_stock_manager,custom_spa_replenishment.group_spa_central_inventory"/>
</odoo>
