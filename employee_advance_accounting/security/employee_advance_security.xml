<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_employee_advance_company" model="ir.rule">
        <field name="name">Employee advance company access</field>
        <field name="model_id" ref="model_employee_advance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('account.group_account_user'))]"/>
    </record>

    <record id="rule_employee_advance_repayment_company" model="ir.rule">
        <field name="name">Employee advance repayment company access</field>
        <field name="model_id" ref="model_employee_advance_repayment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('account.group_account_user'))]"/>
    </record>
</odoo>

