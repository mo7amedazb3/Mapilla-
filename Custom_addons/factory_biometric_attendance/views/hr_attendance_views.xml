<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_list_biometric" model="ir.ui.view">
        <field name="name">hr.attendance.list.biometric</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="out_mode" position="after">
                <field name="biometric_in_device_id" optional="hidden" groups="hr_attendance.group_hr_attendance_manager"/>
                <field name="biometric_out_device_id" optional="hidden" groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
        </field>
    </record>

    <record id="view_attendance_form_biometric" model="ir.ui.view">
        <field name="name">hr.attendance.form.biometric</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="in_mode" position="after">
                <field name="biometric_in_device_id" invisible="in_mode != 'biometric'" groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
            <field name="out_mode" position="after">
                <field name="biometric_out_device_id" invisible="out_mode != 'biometric'" groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
            <xpath expr="//sheet" position="inside">
                <notebook invisible="not biometric_event_ids" groups="hr_attendance.group_hr_attendance_manager">
                    <page string="حركات البصمة" name="biometric_events" groups="hr_attendance.group_hr_attendance_manager">
                        <field name="biometric_event_ids" readonly="1">
                            <list create="false" delete="false" edit="false">
                                <field name="punch_time"/>
                                <field name="device_id"/>
                                <field name="device_user_id"/>
                                <field name="resolved_action" widget="badge"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
