<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_biometric_device_company" model="ir.rule">
        <field name="name">Biometric devices by company</field>
        <field name="model_id" ref="model_factory_biometric_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
    <record id="rule_biometric_identity_company" model="ir.rule">
        <field name="name">Biometric identities by company</field>
        <field name="model_id" ref="model_factory_biometric_identity"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
    <record id="rule_biometric_event_company" model="ir.rule">
        <field name="name">Biometric events by company</field>
        <field name="model_id" ref="model_factory_biometric_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
    <record id="rule_biometric_command_company" model="ir.rule">
        <field name="name">Biometric commands by company</field>
        <field name="model_id" ref="model_factory_biometric_command"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
</odoo>
