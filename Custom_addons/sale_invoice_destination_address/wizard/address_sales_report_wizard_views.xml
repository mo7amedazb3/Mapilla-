<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_address_sales_report_wizard_form" model="ir.ui.view">
        <field name="name">sale.destination.address.report.wizard.form</field>
        <field name="model">sale.destination.address.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Address Sales Report">
                <field name="company_id" invisible="1"/>
                <div class="alert alert-info mb-3" role="alert">
                    Select the invoice period. The report uses posted customer invoices only.
                </div>
                <group col="2">
                    <group string="Period">
                        <field name="date_from" string="From"/>
                        <field name="date_to" string="To"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print"
                            string="Print"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_address_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Address Sales Report</field>
        <field name="res_model">sale.destination.address.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_address_sales_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_address_sales_report"
              name="Address Sales Report"
              parent="sale.menu_sale_report"
              action="action_address_sales_report_wizard"
              sequence="50"/>
</odoo>
