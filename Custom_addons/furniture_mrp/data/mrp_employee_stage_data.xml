    <record id="employee_stage_finishing" model="furniture.mrp.employee.stage">
        <field name="name">تجهيز</field>
        <field name="code">finishing</field>
        <field name="sequence">50</field>
    </record>
    <record id="employee_stage_tailoring" model="furniture.mrp.employee.stage">
