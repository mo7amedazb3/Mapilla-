    <record id="employee_stage_bases" model="furniture.mrp.employee.stage">
        <field name="name">القواعد</field>
        <field name="code">bases</field>
        <field name="sequence">40</field>
    </record>
    <record id="employee_stage_sewing" model="furniture.mrp.employee.stage">
        <field name="name">الخياطة (مرحلة قديمة داخل التفصيل الآن)</field>
        <field name="code">sewing</field>
        <field name="sequence">70</field>
        <field name="active" eval="False"/>
