<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template التقديم -->
    <template id="report_priming_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="brand_company" t-value="doc.production_order_id.company_id"/>
                        <t t-call="furniture_mrp.report_company_brand_logo"/>
                        <h2 class="text-center">أمر التقديم - <t t-out="doc.name"/></h2>
                        <table class="table table-bordered mt-4">
                            <tr><td><strong>المنتج المخطط:</strong></td><td><t t-out="doc.product_id.display_name"/></td>
                                <td><strong>الكمية:</strong></td><td><t t-out="doc.product_qty"/></td></tr>
                            <tr><td><strong>نوع التقديم:</strong></td><td><t t-out="doc.primer_type"/></td>
                                <td><strong>كمية التقديم:</strong></td><td><t t-out="doc.primer_qty_liters"/></td></tr>
                            <tr><td><strong>أوراق الصنفرة:</strong></td><td><t t-out="doc.sandpaper_sheets"/></td>
                                <td><strong>تكلفة العمالة:</strong></td><td><t t-out="doc.labor_cost"/></td></tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

