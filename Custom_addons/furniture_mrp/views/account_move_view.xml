<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_furniture_purchase_uom" model="ir.ui.view">
        <field name="name">account.move.form.furniture.purchase.uom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='invoice_line_ids']//list//field[@name='product_uom_id'])[1]" position="replace">
                <field name="product_uom_id"
                       string="وحدة القياس"
                       width="120px"
                       domain="[('furniture_mrp_bom_uom', '=', True)]"
                       options="{'no_create_edit': True}"
                       column_invisible="parent.move_type not in ['in_invoice', 'in_refund', 'in_receipt']"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_furniture_payroll_payment" model="ir.ui.view">
        <field name="name">account.move.form.furniture.payroll.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="furniture_payroll_date_from" invisible="1"/>
                <field name="furniture_payroll_date_to" invisible="1"/>
                <field name="furniture_payroll_accrual_move_id" invisible="1"/>
                <button name="action_open_furniture_payroll_payment"
                        type="object" string="سداد الأجور"
                        class="btn-primary" icon="fa-money"
                        groups="account.group_account_user"
                        invisible="not furniture_payroll_date_from or furniture_payroll_accrual_move_id or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
