<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_furniture_mrp_production_line_bom_popup" model="ir.ui.view">
        <field name="name">furniture.mrp.production.line.bom.popup</field>
        <field name="model">furniture.mrp.production.line</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="خامات المنتج حسب المرحلة" create="0" edit="1" delete="0"
                  class="o_furniture_production_line_bom_popup">
                <sheet>
                    <field name="use_priming" invisible="1"/>
                    <field name="use_painting" invisible="1"/>
                    <field name="use_carpentry" invisible="1"/>
                    <field name="use_bases" invisible="1"/>
                    <field name="use_finishing" invisible="1"/>
                    <field name="use_tailoring" invisible="1"/>
                    <field name="use_upholstery" invisible="1"/>
                    <field name="use_packaging" invisible="1"/>

                    <div class="oe_title">
                        <span class="text-muted">BoM الخاص بسطر المنتج</span>
                        <h2><field name="product_id" nolabel="1" readonly="1"
                                   options="{'no_open': True}"/></h2>
                    </div>
                    <group>
                        <group string="بيانات المنتج">
                            <field name="production_id" readonly="1" options="{'no_open': True}"/>
                            <field name="furniture_order_model_id" readonly="1" options="{'no_open': True}"/>
                            <field name="bom_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group string="الكمية والمقاس">
                            <field name="product_qty" readonly="1" class="fw-bold"
                                   options="{'minDigits': 1, 'min_display_digits': 1}"/>
                            <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                            <field name="dimension_label" readonly="1"/>
                            <div class="text-muted">
                                عدّل كمية المادة الخام مباشرة من عمود «الكمية» بالأسفل، ثم اضغط حفظ الكميات.
                                التعديل يخص أمر الإنتاج ده فقط ولا يغيّر الريسيبي الأصلية.
                            </div>
                        </group>
                    </group>

                    <notebook class="o_furniture_line_bom_stage_tabs">
                        <page name="bom_priming" string="1. التقديم" invisible="not use_priming">
                            <field name="bom_priming_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_painting" string="2. تصنيع دهانات" invisible="not use_painting">
                            <field name="bom_painting_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_carpentry" string="3. تجميع" invisible="not use_carpentry">
                            <field name="bom_carpentry_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_bases" string="4. القواعد" invisible="not use_bases">
                            <field name="bom_bases_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_finishing" string="5. تجهيز" invisible="not use_finishing">
                            <field name="bom_finishing_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_tailoring" string="6. تفصيل" invisible="not use_tailoring">
                            <field name="bom_tailoring_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_upholstery" string="7. كسوه" invisible="not use_upholstery">
                            <field name="bom_upholstery_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                        <page name="bom_packaging" string="8. التغليف" invisible="not use_packaging">
                            <field name="bom_packaging_material_line_ids" readonly="0" nolabel="1">
                                <list create="0" edit="1" delete="0" editable="bottom">
                                    <field name="bom_qty_editable" column_invisible="True"/>
                                    <field name="product_id" string="المادة الخام" readonly="1" options="{'no_open': True}"/>
                                    <field name="qty_needed" string="الكمية" readonly="not bom_qty_editable"
                                           options="{'minDigits': 1, 'min_display_digits': 1}"/>
                                    <field name="product_uom_id" string="الوحدة" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_unit_cost" string="تكلفة الوحدة" readonly="1"/>
                                    <field name="material_cost" string="تكلفة الكمية" readonly="1"/>
                                    <field name="qty_available" string="المتوفر" readonly="1" optional="show"/>
                                    <field name="availability" string="الحالة" readonly="1" widget="badge"
                                           decoration-success="availability == 'ok'"
                                           decoration-warning="availability == 'partial'"
                                           decoration-danger="availability == 'missing'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="حفظ الكميات" special="save" class="btn-primary"/>
                    <button string="إغلاق بدون حفظ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_furniture_mrp_production_line_quantity_wizard_form" model="ir.ui.view">
        <field name="name">furniture.mrp.production.line.quantity.wizard.form</field>
        <field name="model">furniture.mrp.production.line.quantity.wizard</field>
        <field name="arch" type="xml">
            <form string="تعديل كمية المنتج" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <span class="text-muted">تعديل كمية المنتج وإعادة حساب خاماته</span>
                        <h2><field name="product_id" nolabel="1" readonly="1"
                                   options="{'no_open': True}"/></h2>
                    </div>
                    <group>
                        <group string="البيانات الحالية">
                            <field name="production_id" readonly="1" options="{'no_open': True}"/>
                            <field name="current_product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group string="الكمية الجديدة">
                            <field name="new_product_qty" class="fw-bold"/>
                            <div class="text-muted">
                                بعد الحفظ هتتحدث كميات وتكاليف خامات كل مراحل المنتج تلقائيًا.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" string="حفظ وتحديث الخامات"
                            type="object" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
