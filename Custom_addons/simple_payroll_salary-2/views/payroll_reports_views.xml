<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_simple_payroll_slip_pivot" model="ir.ui.view">
        <field name="name">simple.payroll.slip.pivot</field>
        <field name="model">simple.payroll.slip</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Totals">
                <field name="employee_id" type="row"/>
                <field name="base_wage" type="measure"/>
                <field name="attendance_deduction" type="measure"/>
                <field name="commission_amount" type="measure"/>
                <field name="net_salary" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_simple_payroll_slip_graph" model="ir.ui.view">
        <field name="name">simple.payroll.slip.graph</field>
        <field name="model">simple.payroll.slip</field>
        <field name="arch" type="xml">
            <graph string="Payroll Totals" type="bar">
                <field name="employee_id" type="row"/>
                <field name="net_salary" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_simple_payroll_reports" model="ir.actions.act_window">
        <field name="name">Payroll Summary</field>
        <field name="res_model">simple.payroll.slip</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
