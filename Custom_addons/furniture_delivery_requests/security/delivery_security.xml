<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Global rules also restrict pre-existing factory-manager ACL grants. -->
    <record id="rule_delivery_request_admin" model="ir.rule">
        <field name="name">طلبات التسليم: الأدمن وشركاته فقط</field>
        <field name="model_id" ref="furniture_mrp.model_furniture_mrp_future_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('base.group_system') else [(0, '=', 1)]</field>
    </record>
    <record id="rule_delivery_request_line_admin" model="ir.rule">
        <field name="name">أصناف طلبات التسليم: الأدمن وشركاته فقط</field>
        <field name="model_id" ref="furniture_mrp.model_furniture_mrp_future_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('base.group_system') else [(0, '=', 1)]</field>
    </record>
    <record id="rule_delivery_stage_warning_admin" model="ir.rule">
        <field name="name">تحذيرات طلبات التسليم: الأدمن وشركاته فقط</field>
        <field name="model_id" ref="model_furniture_delivery_request_stage_warning"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('base.group_system') else [(0, '=', 1)]</field>
    </record>
</odoo>
