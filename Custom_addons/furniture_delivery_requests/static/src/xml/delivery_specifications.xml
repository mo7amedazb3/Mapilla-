<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="furniture_delivery_requests.SpecificationButtons" t-inherit="web.FormViewDialog.ToOne.buttons" t-inherit-mode="primary">
        <xpath expr="//button[contains(@class, 'o_form_button_save')]" position="replace">
            <button class="btn btn-primary o_form_button_save o_furniture_tailoring_material_apply_button" t-on-click="saveButtonClicked">حفظ التفاصيل</button>
        </xpath>
        <xpath expr="//button[contains(@class, 'o_form_button_cancel')]" position="replace">
            <button class="btn btn-secondary o_form_button_cancel o_furniture_tailoring_material_cancel_button" t-on-click="discard">إلغاء</button>
        </xpath>
    </t>
</templates>
