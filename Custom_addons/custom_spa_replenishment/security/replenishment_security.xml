<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_spa_replenishment" model="ir.module.category">
        <field name="name">Central Purchase Replenishment</field>
        <field name="description">Manage the single-warehouse central purchase replenishment dashboard.</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_spa_central_inventory" model="res.groups">
        <field name="name">Central Inventory Manager</field>
        <field name="category_id" ref="module_category_spa_replenishment"/>
        <field name="implied_ids" eval="[
            (4, ref('stock.group_stock_user')),
            (4, ref('purchase.group_purchase_user'))
        ]"/>
    </record>
</odoo>
