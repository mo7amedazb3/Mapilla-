<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Keep the factory attendance experience focused on the custom daily
        dashboard. These standard/device administration actions remain intact
        and can still be reached directly by an administrator if needed.
    -->
    <record id="hr_attendance.menu_hr_attendance_view_attendances" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="hr_attendance.menu_hr_attendance_view_attendances_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="hr_attendance.menu_action_open_form" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="factory_biometric_attendance.menu_biometric_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>
