<odoo>
    <record id="assembly_request_form" model="ir.ui.view">
        <field name="name">stage.requisition.form</field>
        <field name="model">furniture.assembly.requisition</field>
        <field name="arch" type="xml">
            <form string="طلب الاذونات" class="o_assembly_requisition o_mapilla_permit_form">
                <header>
                    <button name="action_submit" type="object" string="إرسال لأمين المخزن"
                            icon="fa-paper-plane" class="btn-primary"
                            invisible="state != 'draft' or not can_submit"/>
                    <button name="action_approve" type="object" string="اعتماد ونقل للصالة"
                            icon="fa-check" class="btn-primary"
                            invisible="state != 'pending' or not can_decide"
                            confirm="سيتم نقل الكميات من المخزن إلى صالة المرحلة. هل تريد الاعتماد؟"/>
                    <button name="action_reject" type="object" string="رفض الطلب"
                            icon="fa-times" class="btn-secondary"
                            invisible="state != 'pending' or not can_decide"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,done"/>
                </header>
                <sheet class="o_mapilla_permit_sheet">
                    <field name="config_id" invisible="1"/>
                    <field name="can_submit" invisible="1"/>
                    <field name="can_decide" invisible="1"/>
                    <div class="o_assembly_request_hero">
                        <span class="o_mapilla_permit_hero_icon">
                            <i class="fa fa-cubes" title="خامات المراحل"/>
                        </span>
                        <div class="o_mapilla_permit_hero_copy">
                            <span class="o_mapilla_permit_eyebrow">إدارة خامات المراحل</span>
                            <h1>طلب إذن خامات</h1>
                            <p>تغذية رصيد صالة المرحلة — أدخل الكميات المطلوبة فقط</p>
                        </div>
                        <div class="o_mapilla_permit_reference">
                            <span>رقم الطلب</span>
                            <h2><field name="name"/></h2>
                        </div>
                    </div>
                    <div class="alert alert-info" role="status">
                        تظهر هنا فقط الخامات التي سمح بها مدير الإنتاج لهذا المشرف. الكمية التي تصل من الطلب الخارجي تُخصم من احتياج طلب المرحلة العادي، ويُطلب الباقي فقط.
                    </div>
                    <div class="o_mapilla_permit_flow">
                        <span><i class="fa fa-lock" title="أصناف ثابتة"/> الأصناف والوحدات ثابتة</span>
                        <span><i class="fa fa-edit" title="إدخال الكمية"/> أدخل الكمية فقط</span>
                        <span><i class="fa fa-exchange" title="نقل المخزون"/> الاعتماد ينقل الخامات للصالة</span>
                    </div>
                    <div class="o_mapilla_permit_meta_grid">
                        <section class="o_mapilla_permit_card">
                            <div class="o_mapilla_permit_card_title">
                                <i class="fa fa-industry" title="مسار الطلب"/>
                                <div><strong>مسار الطلب</strong><small>المرحلة ومكان الصرف والاستلام</small></div>
                            </div>
                            <group class="o_mapilla_permit_group">
                                <field name="stage_code" readonly="state != 'draft' or not can_submit"/>
                                <field name="requested_by_id" options="{'no_open': True}"/>
                                <field name="source_id" options="{'no_open': True}"/>
                                <field name="hall_id" options="{'no_open': True}"/>
                            </group>
                        </section>
                        <section class="o_mapilla_permit_card" invisible="state == 'draft'">
                            <div class="o_mapilla_permit_card_title">
                                <i class="fa fa-clock-o" title="بيانات الاعتماد"/>
                                <div><strong>بيانات الاعتماد</strong><small>الإرسال وقرار أمين المخزن</small></div>
                            </div>
                            <group class="o_mapilla_permit_group">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="submitted_at"/>
                                <field name="decided_by_id" options="{'no_open': True}"/>
                                <field name="decided_at"/>
                            </group>
                        </section>
                    </div>
                    <section class="o_mapilla_permit_table_card">
                        <div class="o_mapilla_permit_section_heading">
                            <span class="o_mapilla_permit_section_icon"><i class="fa fa-cubes" title="خامات المرحلة"/></span>
                            <div><strong>خامات المرحلة</strong><small>راجع الصنف والوحدة، ثم أدخل الكمية المطلوبة.</small></div>
                        </div>
                        <field name="line_ids" nolabel="1" class="o_mapilla_permit_lines"
                               readonly="state != 'draft' or not can_submit">
                            <list editable="bottom" create="0" delete="0">
                                <field name="product_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                                <field name="requested_qty"/>
                                <field name="product_uom_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                            </list>
                        </field>
                    </section>
                    <section class="o_mapilla_permit_table_card o_mapilla_permit_moves"
                             invisible="state != 'done'"
                             groups="furniture_mrp.group_furniture_mrp_storekeeper">
                        <div class="o_mapilla_permit_section_heading">
                            <span class="o_mapilla_permit_section_icon"><i class="fa fa-truck" title="حركات الصرف"/></span>
                            <div><strong>حركات الصرف</strong><small>الحركات المخزنية الناتجة عن اعتماد الطلب.</small></div>
                        </div>
                        <field name="move_ids" nolabel="1" class="o_mapilla_permit_lines">
                            <list create="0" delete="0">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="product_uom"/>
                                <field name="location_id"/>
                                <field name="location_dest_id"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </section>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="assembly_request_list" model="ir.ui.view">
        <field name="name">stage.requisition.list</field>
        <field name="model">furniture.assembly.requisition</field>
        <field name="arch" type="xml">
            <list class="o_mapilla_permit_list" decoration-success="state == 'done'" decoration-warning="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="stage_code"/>
                <field name="requested_by_id"/>
                <field name="create_date" options="{'show_time': False}"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="assembly_request_search" model="ir.ui.view">
        <field name="name">stage.requisition.search</field>
        <field name="model">furniture.assembly.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stage_code"/>
                <field name="requested_by_id"/>
                <filter name="pending" string="بانتظار المخزن" domain="[('state','=','pending')]"/>
                <filter name="done" string="تم الصرف" domain="[('state','=','done')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter name="group_stage" string="المرحلة" context="{'group_by': 'stage_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assembly_requests" model="ir.actions.act_window">
        <field name="name">طلب الاذونات</field>
        <field name="res_model">furniture.assembly.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_assembly_store_requests" model="ir.actions.act_window">
        <field name="name">طلبات خامات المراحل</field>
        <field name="res_model">furniture.assembly.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1, 'create': False}</field>
    </record>

    <record id="assembly_supervisor_material_list" model="ir.ui.view">
        <field name="name">assembly.supervisor.material.list</field>
        <field name="model">furniture.assembly.supervisor.material</field>
        <field name="arch" type="xml">
            <list class="o_mapilla_permit_list o_mapilla_permit_policy_list">
                <field name="supervisor_id"/>
                <field name="stage_code"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="assembly_supervisor_material_form" model="ir.ui.view">
        <field name="name">assembly.supervisor.material.form</field>
        <field name="model">furniture.assembly.supervisor.material</field>
        <field name="arch" type="xml">
            <form string="خامات الطلب الخارجي للمشرف" class="o_mapilla_permit_form o_mapilla_permit_policy_form">
                <sheet class="o_mapilla_permit_sheet">
                    <div class="o_assembly_request_hero o_mapilla_policy_hero">
                        <span class="o_mapilla_permit_hero_icon"><i class="fa fa-users" title="خامات المشرفين"/></span>
                        <div class="o_mapilla_permit_hero_copy">
                            <span class="o_mapilla_permit_eyebrow">سياسات الطلب الخارجي</span>
                            <h1>إعداد خامات المشرفين</h1>
                            <p>حدد الخامات التي يستطيع كل مشرف طلبها لصالة مرحلته.</p>
                        </div>
                    </div>
                    <section class="o_mapilla_permit_card o_mapilla_policy_identity">
                        <div class="o_mapilla_permit_card_title">
                            <i class="fa fa-user" title="المشرف والمرحلة"/>
                            <div><strong>المشرف والمرحلة</strong><small>اربط السياسة بمشرف ومرحلة إنتاج محددين.</small></div>
                        </div>
                        <group class="o_mapilla_permit_group">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="supervisor_id"/>
                            <field name="stage_code"/>
                        </group>
                    </section>
                    <section class="o_mapilla_permit_card o_mapilla_policy_products">
                        <div class="o_mapilla_permit_card_title">
                            <i class="fa fa-cubes" title="الخامات المسموحة"/>
                            <div><strong>الخامات المسموحة</strong><small>لن تظهر للمشرف أي خامة غير مختارة هنا.</small></div>
                        </div>
                        <field name="product_ids" widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </section>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_assembly_supervisor_materials" model="ir.actions.act_window">
        <field name="name">خامات المشرفين</field>
        <field name="res_model">furniture.assembly.supervisor.material</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="assembly_request_root" name="الاذونات" sequence="53"
              groups="furniture_mrp.group_furniture_mrp_supervisor_priming,furniture_mrp.group_furniture_mrp_supervisor_painting,furniture_mrp.group_furniture_mrp_supervisor_carpentry,furniture_mrp.group_furniture_mrp_supervisor_bases,furniture_mrp.group_furniture_mrp_supervisor_finishing,furniture_mrp.group_furniture_mrp_supervisor_tailoring,furniture_mrp.group_furniture_mrp_supervisor_upholstery,furniture_mrp.group_furniture_mrp_supervisor_packaging,furniture_mrp.group_furniture_mrp_manager,base.group_system"
              web_icon="furniture_assembly_requisitions,static/description/icon.svg"/>
    <menuitem id="assembly_request_all" name="طلباتي" parent="assembly_request_root" action="action_assembly_requests" sequence="1"
              groups="furniture_mrp.group_furniture_mrp_supervisor_priming,furniture_mrp.group_furniture_mrp_supervisor_painting,furniture_mrp.group_furniture_mrp_supervisor_carpentry,furniture_mrp.group_furniture_mrp_supervisor_bases,furniture_mrp.group_furniture_mrp_supervisor_finishing,furniture_mrp.group_furniture_mrp_supervisor_tailoring,furniture_mrp.group_furniture_mrp_supervisor_upholstery,furniture_mrp.group_furniture_mrp_supervisor_packaging"/>
    <menuitem id="assembly_supervisor_materials" name="إعداد خامات المشرفين"
              parent="assembly_request_root" action="action_assembly_supervisor_materials"
              sequence="20" groups="furniture_mrp.group_furniture_mrp_manager" active="False"/>
    <menuitem id="assembly_requests_store" name="طلبات خامات المراحل" parent="furniture_mrp.menu_furniture_store_permissions_root" action="action_assembly_store_requests" sequence="3" groups="furniture_mrp.group_furniture_mrp_storekeeper"/>
</odoo>
