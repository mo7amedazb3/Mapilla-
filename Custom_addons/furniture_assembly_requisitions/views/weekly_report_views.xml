<odoo>
    <record id="assembly_weekly_material_report_list" model="ir.ui.view">
        <field name="name">assembly.weekly.material.report.list</field>
        <field name="model">furniture.assembly.weekly.material.report</field>
        <field name="arch" type="xml">
            <list class="o_mapilla_permit_list o_mapilla_weekly_list">
                <field name="name"/>
                <field name="week_start"/>
                <field name="week_end"/>
                <field name="line_count"/>
                <field name="counted_line_count"/>
                <field name="variance_line_count"/>
                <field name="generated_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="assembly_weekly_material_report_form" model="ir.ui.view">
        <field name="name">assembly.weekly.material.report.form</field>
        <field name="model">furniture.assembly.weekly.material.report</field>
        <field name="arch" type="xml">
            <form string="متابعة الاستهلاك" create="0" delete="0"
                  class="o_mapilla_permit_form o_mapilla_weekly_inventory_form">
                <sheet class="o_mapilla_permit_sheet">
                    <field name="week_start" invisible="1"/>
                    <field name="week_end" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="line_count" widget="mapilla_material_period" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assembly_weekly_material_report_search" model="ir.ui.view">
        <field name="name">assembly.weekly.material.report.search</field>
        <field name="model">furniture.assembly.weekly.material.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="week_end"/>
            </search>
        </field>
    </record>

    <record id="action_assembly_weekly_material_reports" model="ir.actions.act_window">
        <field name="name">متابعة الاستهلاك</field>
        <field name="res_model">furniture.assembly.weekly.material.report</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_assembly_weekly_material_report_direct" model="ir.actions.server">
        <field name="name">متابعة الاستهلاك</field>
        <field name="model_id" ref="model_furniture_assembly_weekly_material_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_current_report()</field>
    </record>

    <menuitem id="assembly_weekly_material_reports"
              name="متابعة الاستهلاك"
              parent="assembly_request_root"
              action="action_assembly_weekly_material_report_direct"
              sequence="30"
              groups="base.group_system,furniture_mrp.group_furniture_mrp_supervisor"/>
</odoo>
