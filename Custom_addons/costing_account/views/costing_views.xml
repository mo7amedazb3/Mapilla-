<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spa_service_department_list" model="ir.ui.view">
        <field name="name">spa.service.department.list</field>
        <field name="model">spa.service.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_spa_service_department_form" model="ir.ui.view">
        <field name="name">spa.service.department.form</field>
        <field name="model">spa.service.department</field>
        <field name="arch" type="xml">
            <form string="Service Department">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="costing_eligible"/>
                                    <field name="costing_bom_id"/>
                                    <field name="costing_material_cost" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spa_service_department" model="ir.actions.act_window">
        <field name="name">Service Departments</field>
        <field name="res_model">spa.service.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_spa_costing_period_list" model="ir.ui.view">
        <field name="name">spa.costing.period.list</field>
        <field name="model">spa.costing.period</field>
        <field name="arch" type="xml">
            <list class="spa_costing_period_list"
                  decoration-success="state == 'approved'"
                  decoration-info="state == 'calculated'">
                <field name="period_date" string="Month"/>
                <field name="conversion_cost" widget="monetary"/>
                <field name="allocated_conversion_total" string="Applied Cost" widget="monetary"/>
                <field name="profit_total" widget="monetary"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_spa_costing_period_form" model="ir.ui.view">
        <field name="name">spa.costing.period.form</field>
        <field name="model">spa.costing.period</field>
        <field name="arch" type="xml">
            <form string="Monthly Costing" class="spa_costing_period_form">
                <header>
                    <button name="action_calculate" type="object" string="Calculate Costing"
                            icon="fa-calculator" class="oe_highlight" invisible="state == 'approved'"/>
                    <button name="action_approve" type="object" string="Approve"
                            icon="fa-check-circle" class="oe_highlight spa_approve_button"
                            invisible="state != 'calculated'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            icon="fa-refresh"
                            invisible="state == 'draft'"/>
                </header>
                <sheet class="spa_costing_sheet">
                    <div class="spa_costing_hero">
                        <div class="spa_costing_hero_title">
                            <span>Monthly Costing</span>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                    </div>

                    <div class="spa_costing_card spa_costing_inputs">
                        <div class="spa_costing_state">
                            <field name="state" widget="statusbar"
                                   statusbar_visible="draft,calculated,approved"/>
                        </div>
                        <div class="spa_costing_input_grid">
                            <div class="spa_costing_input_section">
                                <h3>Month</h3>
                                <div class="spa_costing_month_field">
                                    <field name="period_date" widget="date"
                                           options="{'min_precision': 'month'}"
                                           readonly="state == 'approved'"/>
                                </div>
                                <h3>Monthly Inputs</h3>
                                <div class="spa_costing_field_row">
                                    <label for="conversion_cost"/>
                                    <field name="conversion_cost" widget="monetary"
                                           readonly="state == 'approved'"/>
                                </div>
                            </div>
                            <div class="spa_costing_input_section spa_costing_period_section">
                                <h3>Period</h3>
                                <div class="spa_costing_field_row">
                                    <label for="date_from"/>
                                    <field name="date_from"/>
                                </div>
                                <div class="spa_costing_field_row">
                                    <label for="date_to"/>
                                    <field name="date_to"/>
                                </div>
                                <field name="company_id" invisible="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="spa_costing_card spa_costing_totals"
                         invisible="state == 'draft'">
                        <h3><i class="fa fa-bar-chart"/> Calculated Totals</h3>
                        <div class="spa_costing_metrics">
                            <div class="spa_costing_metric">
                                <span>Revenue Total</span>
                                <field name="revenue_total" widget="monetary"/>
                            </div>
                            <div class="spa_costing_metric">
                                <span>Material Cost Total</span>
                                <field name="material_cost_total" widget="monetary"/>
                            </div>
                            <div class="spa_costing_metric">
                                <span>Applied Conversion Cost</span>
                                <field name="allocated_conversion_total" widget="monetary"/>
                            </div>
                            <div class="spa_costing_metric">
                                <span>Profit Total</span>
                                <field name="profit_total" widget="monetary"/>
                            </div>
                        </div>
                    </div>

                    <notebook class="spa_costing_notebook">
                        <page string="Department Allocation" icon="fa-users">
                            <field name="department_line_ids"
                                   class="spa_department_allocation"
                                   readonly="state == 'approved'">
                                <list editable="bottom">
                                    <field name="department_id"/>
                                    <field name="previous_orders"/>
                                    <field name="current_orders"/>
                                    <field name="allocation_percentage_display"/>
                                    <field name="conversion_cost" widget="monetary"/>
                                    <field name="cost_rate"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costing Results" icon="fa-pie-chart">
                            <field name="result_line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="invoice_date"/>
                                    <field name="invoice_id"/>
                                    <field name="product_id"/>
                                    <field name="department_id"/>
                                    <field name="quantity"/>
                                    <field name="sale_amount" widget="monetary"/>
                                    <field name="material_cost" widget="monetary"/>
                                    <field name="conversion_cost" widget="monetary"/>
                                    <field name="profit_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_spa_costing_period" model="ir.actions.act_window">
        <field name="name">Monthly Costing</field>
        <field name="res_model">spa.costing.period</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Top Menu for Costing -->
    <menuitem id="menu_spa_costing_root" name="Costing" sequence="30"
              web_icon="costing_account,static/description/icon.png"
              groups="account.group_account_user"/>
    <menuitem id="menu_spa_costing_period" name="Monthly Costing" parent="menu_spa_costing_root"
              action="action_spa_costing_period" sequence="20" groups="account.group_account_user"/>
    <menuitem id="menu_spa_service_department" name="Service Departments" parent="menu_spa_costing_root"
              action="action_spa_service_department" sequence="30" groups="account.group_account_user"/>
    <record id="action_spa_service_bom" model="ir.actions.act_window">
        <field name="name">Service BoMs</field>
        <field name="res_model">mrp.bom</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('product_tmpl_id.type', '=', 'service')]</field>
        <field name="context">{'default_product_qty': 1.0}</field>
    </record>
    <menuitem id="menu_spa_service_bom" name="Service BoMs" parent="menu_spa_costing_root"
              action="action_spa_service_bom" sequence="40" groups="account.group_account_user"/>

</odoo>
