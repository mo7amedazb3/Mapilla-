<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversion_cost_wizard_form" model="ir.ui.view">
        <field name="name">conversion.cost.wizard.form</field>
        <field name="model">conversion.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Conversion Cost">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="labour_account_id"/>
                        <field name="overhead_account_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_conversion_cost_wizard" model="ir.actions.act_window">
        <field name="name">Conversion Cost Report</field>
        <field name="res_model">conversion.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
