<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_advance_repayment_wizard_form" model="ir.ui.view">
        <field name="name">employee.advance.repayment.wizard.form</field>
        <field name="model">employee.advance.repayment.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="advance_id"/>
                    <field name="employee_id"/>
                    <field name="outstanding_balance"/>
                    <field name="installment_id" invisible="1"/>
                    <field name="installment_sequence" invisible="not installment_id"/>
                    <field name="installment_due_date" invisible="not installment_id"/>
                    <field name="installment_balance" invisible="not installment_id"/>
                    <field name="payment_date"/>
                    <field name="amount"/>
                    <field name="journal_id"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_register_repayment" type="object" string="تسجيل الدفع" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
