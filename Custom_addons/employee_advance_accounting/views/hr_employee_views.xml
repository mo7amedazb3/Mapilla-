<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_advances" model="ir.ui.view">
        <field name="name">hr.employee.form.advances</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_employee_advances" icon="fa-money">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="outstanding_advance_balance"/></span>
                        <span class="o_stat_text">Advance Balance</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

