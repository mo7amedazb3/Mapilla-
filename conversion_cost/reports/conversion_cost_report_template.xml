<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_conversion_cost_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row mt-4 mb-4">
                        <div class="col-12 text-center">
                            <h2 style="color: #007bb5; font-weight: bold;">Conversion Cost Report</h2>
                            <h4 class="text-muted">
                                Period: <span t-esc="date_from"/> to <span t-esc="date_to"/>
                            </h4>
                        </div>
                    </div>
                    
                    <br/>

                    <table class="table table-bordered table-striped mt-4" style="border: 2px solid #333;">
                        <thead style="background-color: #f2f2f2;">
                            <tr>
                                <th class="text-left" style="font-size: 18px;">Cost Component</th>
                                <th class="text-right" style="font-size: 18px;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="font-size: 16px;">
                                    <strong><t t-esc="labour_name"/></strong>
                                </td>
                                <td class="text-right" style="font-size: 16px;">
                                    <span t-esc="abs(labour_total)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-size: 16px;">
                                    <strong><t t-esc="overhead_name"/></strong>
                                </td>
                                <td class="text-right" style="font-size: 16px;">
                                    <span t-esc="abs(overhead_total)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot style="background-color: #e6f7ff; border-top: 3px solid #007bb5;">
                            <tr>
                                <td class="text-right" style="font-size: 20px;">
                                    <strong>Total Conversion Cost</strong>
                                </td>
                                <td class="text-right" style="font-size: 20px; color: #d9534f;">
                                    <strong><span t-esc="abs(conversion_cost)" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    
                    <div class="row mt-5">
                        <div class="col-12 text-muted text-center">
                            <small>This report was generated automatically. Amounts shown are absolute values.</small>
                        </div>
                    </div>
                    <div class="oe_structure"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
